{
  "extends": "@react-native/typescript-config",

  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "jsx": "react-native",
    "strict": true,

    "types": ["node"],
    "typeRoots": ["./types", "./node_modules/@types"],

    "baseUrl": ".",
    "paths": {
      "@env": ["types/env.d.ts"]
    }
  },

  "include": ["src", "types"],
  "exclude": ["node_modules", "Pods"]
}
